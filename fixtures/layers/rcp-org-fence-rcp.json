{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyOutsideOrg",
      "Effect": "Deny",
      "Action": "s3:*",
      "Resource": "*",
      "Principal": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:PrincipalOrgID": "o-ours1234"
        }
      }
    },
    {
      "Sid": "DenyDDBOutsideOrg",
      "Effect": "Deny",
      "Action": "dynamodb:*",
      "Resource": "*",
      "Principal": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:PrincipalOrgID": "o-ours1234"
        }
      }
    }
  ]
}
