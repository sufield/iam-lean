{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowSAML",
      "Effect": "Allow",
      "Action": "sts:AssumeRoleWithSAML",
      "Principal": {
        "Federated": "arn:aws:iam::111122223333:saml-provider/ExampleProvider"
      }
    },
    {
      "Sid": "AllowOIDC",
      "Effect": "Allow",
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Principal": {
        "Federated": "arn:aws:iam::111122223333:oidc-provider/token.example.com"
      }
    }
  ]
}
