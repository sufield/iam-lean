{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OrgIdArrayMixed",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::shared-bucket/*",
      "Condition": {
        "StringEquals": {
          "aws:PrincipalOrgID": ["o-ours1234", "o-foreign999"]
        }
      }
    }
  ]
}
