{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ExternalRoleForeignOrg",
      "Effect": "Allow",
      "Principal": {"AWS": "arn:aws:iam::444455556666:role/DeployRole"},
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::shared-bucket/*",
      "Condition": {
        "StringEquals": {
          "aws:PrincipalOrgID": "o-foreign999"
        }
      }
    }
  ]
}
