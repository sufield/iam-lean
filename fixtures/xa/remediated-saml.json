{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowSAML",
      "Effect": "Allow",
      "Action": "sts:AssumeRoleWithSAML",
      "Principal": {
        "Federated": "arn:aws:iam::111122223333:saml-provider/ExampleProvider"
      },
      "Condition": {
        "StringEquals": {
          "SAML:aud": "https://signin.aws.amazon.com/saml"
        }
      }
    },
    {
      "Sid": "AllowOIDC",
      "Effect": "Allow",
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Principal": {
        "Federated": "arn:aws:iam::111122223333:oidc-provider/token.example.com"
      },
      "Condition": {
        "StringEquals": {
          "token.example.com:sub": "system:serviceaccount:default:my-app"
        }
      }
    }
  ]
}
