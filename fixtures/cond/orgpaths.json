{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OrgPathScoped",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::my-bucket/*",
      "Condition": {
        "ForAnyValue:StringLike": {
          "aws:PrincipalOrgPaths": ["o-ours1234/*/ou-abc/*"]
        }
      }
    }
  ]
}
