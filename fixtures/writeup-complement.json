{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllExceptIAM",
      "Effect": "Allow",
      "NotAction": ["iam:*", "organizations:*"],
      "Resource": "*"
    },
    {
      "Sid": "S3ReadExceptSecrets",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "NotResource": ["arn:aws:s3:::secrets-bucket/*"]
    }
  ]
}
